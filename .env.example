# Optional: You can also configure these directly in the web UI Settings modal (saved to .env.local).
# Presets supported out of the box: deepseek, gemini, openrouter, openai, ollama

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# DeepSeek V4.1 Flash (non-thinking mode is automatically set on live calls)
LLM_FAST_MODEL=deepseek-flash
LLM_CALIBRATION_MODEL=deepseek-reasoner

# Local Apple Silicon STT model (v3 multilingual default, or mlx-community/parakeet-tdt-0.6b-v2 for English A/B)
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
MOCK_HELPER_PORT=8765
