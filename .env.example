# Mockery configuration (normally managed automatically via Settings -> .env.local)
# Copy to .env.local only if you prefer manual configuration.

# AI Assistant provider (optional — Mockery works in Transcript-Only mode without one!)
# Cloud APIs:   gemini | anthropic | openai | deepseek | openrouter
# Local models: omlx | ollama | lmstudio
# Local CLIs:   claude_cli | codex_cli | gemini_cli | agy | pi
# No AI:        none
LLM_PROVIDER=gemini

# Set ONE provider key if using a Cloud API (or paste it inside Mockery's Settings UI):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OMLX_API_KEY=        # only needed if you enabled auth in oMLX

# Local speech-to-text model (runs 100% offline on Apple Silicon via MLX):
# Default (fastest & cleanest for English):
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2
# Optional multilingual (25 European languages):
# PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# Optional overrides:
# MOCKERY_PORT=8765
# MOCKERY_HOME=~/Library/Application Support/Mockery
